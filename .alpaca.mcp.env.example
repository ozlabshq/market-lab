# Alpaca API key credentials for the official alpaca-mcp-server.
# These are NOT dashboard login username/password.
ALPACA_API_KEY=your_paper_api_key_id
ALPACA_SECRET_KEY=your_paper_api_secret
ALPACA_PAPER_TRADE=true
# Read-only-ish Market Lab set. Avoid trading/watchlists/account until explicitly approved.
ALPACA_TOOLSETS=assets,stock-data,options-data,news,corporate-actions
